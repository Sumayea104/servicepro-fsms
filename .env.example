NODE_ENV=development
PORT=5000
FRONTEND_URL=http://localhost:3000

# PostgreSQL (e.g. Neon)
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/servicepro?sslmode=require"

# JWT (JWT_ACCESS_SECRET is accepted as an alias of JWT_SECRET)
JWT_SECRET=replace_with_a_long_random_string
JWT_REFRESH_SECRET=replace_with_a_different_long_random_string
JWT_ACCESS_EXPIRES=15m
JWT_REFRESH_EXPIRES=7d

# Google OAuth
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Stripe (test mode). The webhook secret comes from the Stripe dashboard / `stripe listen`
# Job prices are BDT; card (Stripe) charges are converted to USD at this rate
BDT_PER_USD=120
STRIPE_SECRET_KEY=sk_test_xxx
STRIPE_WEBHOOK_SECRET=whsec_xxx

# bKash sandbox (BKASH_URL is accepted as an alias of BKASH_BASE_URL)
BKASH_BASE_URL=https://tokenized.sandbox.bka.sh/v1.2.0-beta
BKASH_USERNAME=
BKASH_PASSWORD=
BKASH_APP_KEY=
BKASH_APP_SECRET=
BKASH_CALLBACK_URL=http://localhost:5000/api/v1/payments/bkash/callback

# Cloudinary
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Redis (optional)
REDIS_URL=

# Seeded admin
ADMIN_EMAIL=admin@servicepro.com
ADMIN_PASSWORD=Admin123!
