NODE_ENV=development
PORT=5000
FRONTEND_URL=http://localhost:3000

# PostgreSQL (e.g. Neon, Supabase, Render Postgres)
DATABASE_URL=""

# JWT

JWT_ACCESS_SECRET=""
JWT_REFRESH_SECRET=""
JWT_ACCESS_EXPIRES_IN="15m"
JWT_REFRESH_EXPIRES_IN="30d"

# Google OAuth (Social Login)
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# Stripe
BDT_PER_USD=120
STRIPE_SECRET_KEY=""

    STRIPE_PUBLISHABLE_KEY=""
    successUrl: parsedEnv.data.STRIPE_SUCCESS_URL,
    
    webhookSecret: parsedEnv.data.STRIPE_WEBHOOK_SECRET=""

    STRIPE_SUCCESS_URL=http://localhost:3000/payment/success,
STRIPE_CANCEL_URL=http://localhost:3000/payment/cancel

# bKash (sandbox checkout)
# bKash Sandbox Config
BKASH_APP_KEY=""
BKASH_APP_SECRET=""
BKASH_USERNAME=""
BKASH_PASSWORD=""
BKASH_URL=""
BKASH_CALLBACK_URL=""

# Cloudinary (file uploads)
CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""
CLOUDINARY_URL=""



# Redis (optional — caching + shared rate limiting)
REDIS_URL=""

# Resend (transactional email, optional)
RESEND_API_KEY=
EMAIL_FROM=no-reply@servicepro.local

# WebSocket client URL (informational, used by frontends connecting to /ws)
WS_URL=ws://localhost:5000/ws

# Demo admin, created by the seed script
ADMIN_EMAIL=admin@servicepro.com
ADMIN_PASSWORD=Admin123!
